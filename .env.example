# Vercel Postgres / Neon: Storage → your database → copy both URLs.
# If you only have one connection string, paste it in both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="admin@mervesenaskar.local"
ADMIN_PASSWORD="change-me"

# Randevu / iletişim e-posta bildirimi (Resend ücretsiz kota). SMS ücretlidir, kullanılmaz.
RESEND_API_KEY=""
NOTIFY_EMAIL="you@example.com"
# İsteğe bağlı: kendi alan adınızı Resend’de doğruladıktan sonra
# NOTIFY_FROM="Diş Hekimi Merve Şen Aşkar <randevu@your-domain.com>"

