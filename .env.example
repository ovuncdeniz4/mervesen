# Vercel Postgres / Neon: Storage → your database → copy both URLs.
# If you only have one connection string, paste it in both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="admin@mervesenaskar.local"
ADMIN_PASSWORD="change-me"

# Randevu / iletişim e-posta bildirimi (Resend ücretsiz kota). SMS ücretlidir, kullanılmaz.
RESEND_API_KEY=""
# Resend hesabınızın gerçek e-postası. you@example.com yazmayın.
NOTIFY_EMAIL=""
# NOTIFY_FROM kullanmayın (kod yok sayar). example.com 403 verir; Resend’de eklemeyin.
# Gönderen her zaman onboarding@resend.dev.

